DATABASE_URL=postgres://sankalp:sankalp@localhost:5432/sankalp_dev

# The test suites TRUNCATE, so they refuse to run against anything that
# is not visibly a test database. This is read in preference to
# DATABASE_URL by test/setup.ts, so `npm test` works without having to
# override the variable on every invocation.
TEST_DATABASE_URL=postgres://sankalp:sankalp@localhost:5432/sankalp_test
PORT=3000
