DATABASE_URL=postgres://sankalp:sankalp@localhost:5432/sankalp_dev

# The test suites TRUNCATE, so they refuse to run against anything that
# is not visibly a test database. This is read in preference to
# DATABASE_URL by test/setup.ts, so `npm test` works without having to
# override the variable on every invocation.
TEST_DATABASE_URL=postgres://sankalp:sankalp@localhost:5432/sankalp_test
PORT=3000

# ── Sessions: video rooms and recording ──────────────────────────────
# Unset (the default) uses the sandbox room and recorder: no media, no
# recording, safe for dev and tests. `agora` requires EVERY value below,
# or the API refuses to start rather than pretend to record.
# ROOM_PROVIDER=agora
# AGORA_APP_ID=
# AGORA_APP_CERTIFICATE=
# RESTful API credentials (Agora console → RESTful API), not the certificate.
# AGORA_CUSTOMER_KEY=
# AGORA_CUSTOMER_SECRET=
# Private bucket in ap-south-1. Use a dedicated IAM user that can only
# PutObject under sessions/ — Agora writes there directly.
# RECORDING_S3_BUCKET=
# RECORDING_S3_ACCESS_KEY=
# RECORDING_S3_SECRET_KEY=
# Agora's code for the S3 region; 14 is ap-south-1 (Mumbai), the default.
# RECORDING_S3_REGION_CODE=14

# ── Accounts: email and emailed links ────────────────────────────────
# Emails (password reset, email confirmation, credential decisions) are
# queued in the outbox and sent by the relay. The relay only runs when
# this is set — without it nothing is sent until POST /admin/outbox/relay.
OUTBOX_RELAY_INTERVAL_MS=15000
# Unset (the default) logs each email to the API console instead of
# sending it; in development the log includes the link, so you can click
# it. `ses` sends through Amazon SES and requires EMAIL_FROM. AWS
# credentials come from the standard AWS chain (AWS_ACCESS_KEY_ID etc.).
# EMAIL_TRANSPORT=ses
# EMAIL_FROM=Sankalp <no-reply@your-verified-domain>
# SES_REGION=ap-south-1
# Signs reset and confirmation links. At least 32 characters. Unset means
# a random key per process: links stop working when the API restarts.
# ACCOUNT_TOKEN_SECRET=
# Where emailed links point — the web app's public address.
# PUBLIC_WEB_URL=http://localhost:3002
