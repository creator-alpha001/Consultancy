DATABASE_URL=postgres://sankalp:sankalp@localhost:5432/sankalp_dev

# The test suites TRUNCATE, so they refuse to run against anything that
# is not visibly a test database. This is read in preference to
# DATABASE_URL by test/setup.ts, so `npm test` works without having to
# override the variable on every invocation.
TEST_DATABASE_URL=postgres://sankalp:sankalp@localhost:5432/sankalp_test
PORT=3000

# ── Sessions: video rooms and recording ──────────────────────────────
# Unset (the default) uses the sandbox room and recorder: no media, no
# recording, safe for dev and tests. `agora` requires EVERY value below,
# or the API refuses to start rather than pretend to record.
# ROOM_PROVIDER=agora
# AGORA_APP_ID=
# AGORA_APP_CERTIFICATE=
# RESTful API credentials (Agora console → RESTful API), not the certificate.
# AGORA_CUSTOMER_KEY=
# AGORA_CUSTOMER_SECRET=
# Private bucket in ap-south-1. Use a dedicated IAM user that can only
# PutObject under sessions/ — Agora writes there directly.
# RECORDING_S3_BUCKET=
# RECORDING_S3_ACCESS_KEY=
# RECORDING_S3_SECRET_KEY=
# Agora's code for the S3 region; 14 is ap-south-1 (Mumbai), the default.
# RECORDING_S3_REGION_CODE=14
